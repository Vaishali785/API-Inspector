{
	"manifest_version": 3,
	"name": "Console Fix",
	"description": "Fix console issues and warnings using AI",
	"version": "1.0",
	"icons": {
		"16": "icons/icon.png"
	},
	"action": {
		"default_popup": "./popup/index.html"
	},
	"permissions": ["storage"],
	"devtools_page": "devtools.html",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	}
}
